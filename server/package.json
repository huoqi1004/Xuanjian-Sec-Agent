{
  "name": "xuanjian-security-agent-server",
  "version": "1.0.0",
  "description": "玄鉴安全智能体 - 多引擎协同安全评估系统后端服务",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit test/helpers.test.js test/queue.test.js test/metrics.test.js test/scanService.test.js test/database.test.js test/auth.test.js test/retention.test.js",
    "test:integration": "jest --runInBand --forceExit test/api.test.js",
    "db:schema": "node ../scripts/n06/generate-schema.js",
    "db:migrate": "node ../scripts/n06/run-migrations.js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "services/**/*.js",
      "utils/**/*.js",
      "db/**/*.js"
    ]
  },
  "dependencies": {
    "axios": "^1.18.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.1.0",
    "json-rules-engine": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "mysql2": "^3.23.2",
    "node-cron": "^4.0.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^9.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.23.0",
    "ssh2": "^1.17.0",
    "uuid": "^11.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.0",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
